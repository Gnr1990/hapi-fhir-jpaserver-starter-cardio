{
    "realm": "fhir-realm",
    "enabled": true,
    "clients": [
      {
        "clientId": "fhir-client",
        "enabled": true,
        "publicClient": false,
        "secret": "fhir-client-secret",
        "redirectUris": ["*"],
        "serviceAccountsEnabled": true,
        "directAccessGrantsEnabled": true
      }
    ],
    "users": [
      {
        "username": "user",
        "enabled": true,
        "credentials": [
          {
            "type": "password",
            "value": "user-password"
          }
        ]
      },
      {
        "username": "admin",
        "enabled": true,
        "credentials": [
          {
            "type": "password",
            "value": "admin-password"
          }
        ]
      }
    ]
  }